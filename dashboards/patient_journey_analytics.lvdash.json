{
  "datasets": [
    {
      "displayName": "Journey status",
      "name": "p8b1jrn1",
      "query": "SELECT therapy_code, CAST(on_therapy AS STRING) AS on_therapy, COUNT(*) AS patient_count, ROUND(AVG(days_since_last_fill), 1) AS avg_days_since_fill, SUM(pa_denial_count) AS pa_denials FROM main.gold.patient_journey GROUP BY therapy_code, on_therapy"
    },
    {
      "displayName": "At-risk patients",
      "name": "p8b2risk",
      "query": "SELECT patient_token, therapy_code, last_fill_date, days_since_last_fill, pa_denial_count, hub_interactions_30d, CAST(on_therapy AS STRING) AS on_therapy FROM main.gold.patient_journey ORDER BY days_since_last_fill DESC LIMIT 200"
    },
    {
      "displayName": "Journey detail",
      "name": "p8b3detl",
      "query": "SELECT therapy_code, days_since_last_fill, CAST(on_therapy AS STRING) AS on_therapy, pa_denial_count, hub_interactions_30d FROM main.gold.patient_journey"
    }
  ],
  "pages": [
    {
