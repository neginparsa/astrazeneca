      "displayName": "Patient Journey",
      "layout": [
        {
          "position": { "x": 0, "y": 0, "width": 6, "height": 1 },
          "widget": {
            "name": "hdr10001",
            "textbox_spec": "# Patient Journey and Continuity of Care"
