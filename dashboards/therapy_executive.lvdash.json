{
  "datasets": [
    {
      "displayName": "Executive KPIs",
      "name": "e7a1kpi1",
      "query": "SELECT SUM(active_patients) AS total_active_patients, ROUND(SUM(total_paid_amount), 2) AS total_paid_amount, COUNT(DISTINCT therapy_code) AS therapy_count, ROUND(AVG(avg_days_supply), 1) AS avg_days_supply FROM main.gold.daily_therapy_metrics"
    },
    {
      "displayName": "Daily therapy trend",
      "name": "e7a2trnd",
      "query": "SELECT metric_date, therapy_code, active_patients, total_paid_amount, avg_days_supply FROM main.gold.daily_therapy_metrics ORDER BY metric_date, therapy_code"
    },
    {
      "displayName": "Therapy summary",
      "name": "e7a3summ",
      "query": "SELECT therapy_code, SUM(active_patients) AS patient_fills, ROUND(SUM(total_paid_amount), 2) AS paid_amount, ROUND(AVG(avg_days_supply), 1) AS avg_days_supply FROM main.gold.daily_therapy_metrics GROUP BY therapy_code ORDER BY paid_amount DESC"
    }
  ],
  "pages": [
    {
      "name": "a1b2c3d4",
      "displayName": "Executive Overview",
      "layout": [
        {
          "position": { "x": 0, "y": 0, "width": 6, "height": 1 },
          "widget": {
            "name": "hdr00001",
            "textbox_spec": "# Magnolia Pharma — Therapy Performance"
          }
        },
        {
          "position": { "x": 0, "y": 1, "width": 2, "height": 2 },
          "widget": {
            "name": "kpi00001",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "e7a1kpi1",
                  "disaggregated": true,
                  "fields": [
                    { "name": "total_active_patients", "expression": "`total_active_patients`" }
                  ]
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "total_active_patients",
                  "displayName": "Active patient fills"
                }
              },
              "frame": { "showTitle": true, "title": "Active Patients" }
            }
          }
        },
        {
          "position": { "x": 2, "y": 1, "width": 2, "height": 2 },
