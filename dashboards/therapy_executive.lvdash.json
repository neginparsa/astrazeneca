              {
                "name": "main_query",
                "query": {
                  "datasetName": "e7a1kpi1",
                  "disaggregated": true,
                  "fields": [
                    { "name": "total_paid_amount", "expression": "`total_paid_amount`" }
                  ]
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "total_paid_amount",
